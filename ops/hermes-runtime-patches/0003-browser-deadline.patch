+"""Resolver budgets using synthetic profiles/processes only; never a host browser."""
+import json
+import os
+import subprocess
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+import hermes_cli.browser_connect as bc
+import tools.browser_tool as bt
+import tools.browser_use_cli as bu
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = [100.0]
+    monkeypatch.setattr(time, "monotonic", lambda: now[0])
+    return now
+
+
+@pytest.fixture
+def exec_stubs(monkeypatch):
+    monkeypatch.setattr(bu, "_blocked_url_in_code", lambda code: None)
+    monkeypatch.setattr(bu, "_find_cli", lambda: ["synthetic-browser-use"])
+    monkeypatch.setattr(bu, "_base_subprocess_env", lambda: {})
+    monkeypatch.setattr(bu, "_read_browser_cfg", lambda: {})
+    monkeypatch.setattr(bu, "_workspace_dir", lambda task: None)
+    monkeypatch.setattr(bu, "_resolve_real_profile_cdp", lambda *a, **kw: None)
+    monkeypatch.setattr(bu, "_resolve_backend_cdp", lambda *a, **kw: None)
+    run = Mock(return_value=SimpleNamespace(returncode=0, stdout="ok", stderr=""))
+    monkeypatch.setattr(bu.subprocess, "run", run)
+    return run
+
+
+@pytest.mark.parametrize("timeout, expected", [(35, 35), (None, 300), ("bad", 300), (1, 5), (9000, 1800)])
+def test_single_budget_and_legacy_normalization(monkeypatch, clock, exec_stubs, timeout, expected):
+    seen = []
+
+    def resolve(*args, deadline, **kwargs):
+        seen.append(deadline)
+        clock[0] += 1
+
+    monkeypatch.setattr(bu, "_resolve_real_profile_cdp", resolve)
+    monkeypatch.setattr(bu, "_resolve_backend_cdp", resolve)
+    result = json.loads(bu.browser_exec("print(1)", timeout_s=timeout))
+    assert result["success"]
+    assert seen == [100 + expected, 100 + expected]
+    assert exec_stubs.call_args.kwargs["timeout"] == expected - 2
+
+
+@pytest.mark.parametrize("stage", ["_blocked_url_in_code", "_resolve_real_profile_cdp", "_resolve_backend_cdp", "_workspace_dir"])
+def test_no_cli_after_cooperative_io_overruns(monkeypatch, clock, exec_stubs, stage):
+    def delayed(*args, **kwargs):
+        clock[0] += 36
+        return None
+
+    monkeypatch.setattr(bu, stage, delayed)
+    result = json.loads(bu.browser_exec("print(1)", timeout_s=35))
+    assert "timed out" in result["error"]
+    exec_stubs.assert_not_called()
+
+
+def test_policy_rejection_still_precedes_resolvers(monkeypatch, exec_stubs):
+    monkeypatch.setattr(bu, "_blocked_url_in_code", lambda code: "website access denied")
+    resolve = Mock()
+    monkeypatch.setattr(bu, "_resolve_real_profile_cdp", resolve)
+    assert "website access denied" in json.loads(bu.browser_exec("print(1)"))["error"]
+    resolve.assert_not_called()
+    exec_stubs.assert_not_called()
+
+
+def test_no_local_without_consent(monkeypatch, exec_stubs):
+    monkeypatch.setattr(bu, "_real_profile_consented", lambda: False)
+    assert "use_real_profile is off" in json.loads(bu.browser_exec("print(1)", local=True))["error"]
+    exec_stubs.assert_not_called()
+
+
+@pytest.mark.parametrize("target, invoke", [
+    ("_real_profile_cdp_lock", lambda d: bt._real_profile_cdp(deadline=d)),
+    ("_cloud_provider_cache_lock", lambda d: bt._get_cloud_provider(deadline=d)),
+    ("_cleanup_lock", lambda d: bt._get_session_info("synthetic", deadline=d)),
+])
+def test_contended_locks_use_remaining_budget(monkeypatch, target, invoke):
+    lock = threading.Lock()
+    monkeypatch.setattr(bt, target, lock)
+    monkeypatch.setattr(bt, "_use_real_profile", lambda: True)
+    monkeypatch.setattr(bt, "_using_lightpanda_engine", lambda: False)
+    detect = Mock(side_effect=AssertionError("must not probe behind lock"))
+    monkeypatch.setattr(bc, "detect_default_chromium", detect)
+    lock.acquire()
+    started = time.monotonic()
+    try:
+        with pytest.raises(TimeoutError, match="lock"):
+            invoke(started + 0.03)
+        assert time.monotonic() - started < 1
+        assert lock.locked()  # not acquired/released by timed-out caller
+        detect.assert_not_called()
+    finally:
+        lock.release()
+
+
+def test_lock_released_after_stage_failure():
+    lock = threading.Lock()
+    with pytest.raises(RuntimeError):
+        with bc.browser_deadline_lock(lock, time.monotonic() + 1, "test lock"):
+            raise RuntimeError("synthetic stage failure")
+    assert not lock.locked()
