+    monkeypatch.setattr(bt, "_start_browser_cleanup_thread", lambda **kw: None)
+    monkeypatch.setattr(bt, "_update_session_activity", lambda *a, **kw: None)
+    override = Mock(return_value="")
+    monkeypatch.setattr(bt, "_get_cdp_override", override)
+    provider = Mock()
+    def create(task):
+        clock[0] = 134.75
+        return {"session_name": "synthetic", "bb_session_id": "synthetic-id",
+                "cdp_url": "http://synthetic.invalid:9222"}
+    provider.create_session.side_effect = create
+    monkeypatch.setattr(bt, "_get_cloud_provider", lambda **kw: provider)
+    resolutions = []
+    def resolve(url, *, deadline):
+        assert deadline == 135
+        assert bc.browser_remaining(deadline, "synthetic probe", 10) == .25
+        resolutions.append(url)
+        if len(resolutions) == 2:  # helper re-resolves after session publication
+            clock[0] += .3 if late else .1
+        return "ws://synthetic.invalid/devtools/browser/x"
+    monkeypatch.setattr(bt, "_resolve_cdp_override", resolve)
+    registry = Mock()
+    monkeypatch.setattr(bs, "SUPERVISOR_REGISTRY", registry)
+    monkeypatch.setattr(bt, "_get_dialog_policy_config", lambda: ("must_respond", 300))
+    if late:
+        with pytest.raises(bc.BrowserDeadlineExpired):
+            bt._get_session_info("synthetic", deadline=135)
+        registry.get_or_start.assert_not_called()
+    else:
+        bt._get_session_info("synthetic", deadline=135)
+        assert registry.get_or_start.call_args.kwargs["deadline"] == 135
+    assert override.call_args.kwargs == {"deadline": 135}
+    provider.close_session.assert_not_called()  # published session is shared
