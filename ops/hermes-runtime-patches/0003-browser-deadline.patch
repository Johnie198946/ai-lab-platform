+@pytest.fixture
+def clock(monkeypatch):
+    now = [100.0]
+    monkeypatch.setattr(time, "monotonic", lambda: now[0])
+    return now
+
+
+class BudgetLock:
+    def __init__(self, clock, *, block_on=1):
+        self.clock = clock
+        self.block_on = block_on
+        self.calls = []
+        self.releases = 0
+
+    def acquire(self, **kwargs):
+        self.calls.append(kwargs)
+        if len(self.calls) == self.block_on:
+            self.clock[0] += kwargs["timeout"]
+            return False
+        return True
+
+    def release(self):
+        self.releases += 1
+
+
+@pytest.mark.parametrize("late", [False, True])
+def test_provider_leaves_quarter_second_for_real_helper(monkeypatch, clock, late):
+    monkeypatch.setattr(bt, "_active_sessions", {})
