+    launch = Mock(side_effect=popen)
+    monkeypatch.setattr(bt.subprocess, "Popen", launch)
+    run = Mock(return_value=SimpleNamespace(returncode=0, stdout="", stderr=""))
+    monkeypatch.setattr(bt.subprocess, "run", run)
