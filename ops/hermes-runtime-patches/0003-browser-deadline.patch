+class BrowserDeadlineExpired(TimeoutError):
+    """The caller's shared browser budget was exhausted (not a socket timeout)."""
+
+
+def browser_remaining(deadline: float | None, stage: str, cap: float | None = None):
+    """Remaining monotonic budget; None preserves legacy per-operation limits.
+
+    Cooperative at synchronous I/O boundaries, NOT a thread-based hard timeout.
+    DNS, config/plugin I/O, process creation/reaping and result encoding may
+    overrun; callers check again before the next side effect. Socket timeouts
+    bound individual waits, not trickling responses or OS name resolution.
+    """
+    if deadline is None:
+        return cap
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise BrowserDeadlineExpired(f"browser-use timed out during {stage}")
+    return min(remaining, cap) if cap is not None else remaining
+
+
+@contextmanager
+def browser_deadline_lock(lock, deadline: float | None, stage: str):
+    if deadline is None:
+        lock.acquire()
+    elif not lock.acquire(timeout=browser_remaining(deadline, stage)):
+        raise BrowserDeadlineExpired(f"browser-use timed out during {stage}")
+    try:
+        browser_remaining(deadline, stage)
+        yield
+    finally:
+        lock.release()
+
