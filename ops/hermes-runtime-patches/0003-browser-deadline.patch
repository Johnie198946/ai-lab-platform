+@pytest.mark.parametrize("stage", ["detect_default_chromium", "snapshot_real_profile", "chromium_executable"])
+def test_prelaunch_stage_overrun_fails_closed(monkeypatch, clock, real_profile_stubs, tmp_path, stage):
+    def delayed(*args, **kwargs):
+        clock[0] = 136
+        return (str(tmp_path), None) if stage == "snapshot_real_profile" else "chrome"
+
+    monkeypatch.setattr(bc, stage, delayed)
+    with pytest.raises(TimeoutError):
+        bt._real_profile_cdp(deadline=135)
+    real_profile_stubs.launch.assert_not_called()
+    assert not bt._real_profile_cdp_lock.locked()
