[Unit]
Description=AI Lab resource pressure guard
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ai-lab-resource-guard
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=ai-lab-resource-guard
StateDirectoryMode=0755
ReadWritePaths=/var/lib/ai-lab-resource-guard
