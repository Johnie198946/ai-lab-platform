[Unit]
Description=Hermes Bridge
After=network-online.target hermes-serve.service
Wants=network-online.target

[Service]
Type=simple
User=quantumn-hermes
Group=quantumn-hermes
WorkingDirectory=/opt/ai-lab-platform
EnvironmentFile=/opt/ai-lab-platform/.env
EnvironmentFile=/etc/ai-lab-platform/hermes-bridge.env
EnvironmentFile=-/etc/ai-lab-platform/hermes-egress.env
Environment=HOME=/var/lib/quantumn-hermes
Environment=HERMES_HOME=/var/lib/quantumn-hermes/.hermes
Environment=HERMES_AGENT_ROOT=/var/lib/quantumn-hermes/.hermes/hermes-agent
Environment=HERMES_BIN=/var/lib/quantumn-hermes/.local/bin/hermes
Environment=PYTHONUNBUFFERED=1
Environment=AI_LAB_AGENT_OS_MODE=cloud_multi_tenant
Environment=HERMES_DURABLE_CHAT_WORKER=true
Environment=HERMES_CHAT_RUN_DB=/opt/ai-lab-platform/data/hermes_chat_runs.sqlite3
Environment=HERMES_FAST_CHAT_MODEL=gpt-5.6-luna
Environment=HERMES_BALANCED_CHAT_MODEL=gpt-5.6-sol
Environment=HERMES_REASONING_CHAT_MODEL=gpt-5.6-sol
Environment=HERMES_MAX_CONCURRENCY=2
Environment=HERMES_MAX_QUEUE=8
Environment=HERMES_QUEUE_TIMEOUT_SECONDS=30
Environment=QUANTUM_RUNTIME_SHARD_ID=shard-1
Environment=QUANTUM_RUNTIME_SHARDS=shard-1
ExecStart=/var/lib/quantumn-hermes/bridge-worker-venv/bin/python scripts/hermes_bridge.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ai-lab-platform/data /var/lib/quantumn-hermes/.hermes

[Install]
WantedBy=multi-user.target
