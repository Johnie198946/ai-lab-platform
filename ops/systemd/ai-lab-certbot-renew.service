[Unit]
Description=Renew AI Lab short-lived IP TLS certificate
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-lab-platform
ExecStart=/bin/bash /opt/ai-lab-platform/scripts/renew_tls_certificate.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /run/lock
