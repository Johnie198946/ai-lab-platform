[Unit]
Description=Renew AI Lab short-lived IP TLS certificate
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-lab-platform
ExecStart=/opt/certbot-venv/bin/certbot renew --cert-name 120.24.248.58 --non-interactive --quiet --pre-hook "/usr/bin/docker compose -f /opt/ai-lab-platform/docker-compose.yml stop frontend" --post-hook "/usr/bin/docker compose -f /opt/ai-lab-platform/docker-compose.yml up -d frontend" --deploy-hook "/usr/bin/docker compose -f /opt/ai-lab-platform/docker-compose.yml restart frontend"
