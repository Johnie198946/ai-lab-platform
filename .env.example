# AI Lab Platform 部署环境变量（复制为 .env 使用）
# docker compose 会自动读取同目录 .env

# PostgreSQL
POSTGRES_DB=ai_lab
POSTGRES_USER=ailab
POSTGRES_PASSWORD=change_me_strong_password

# 问答 API（/api/chat）需要
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Authen 统一认证（与认证服务共享的 HS256 密钥；配置后 API 强制 Bearer JWT）
AUTHEN_JWT_SECRET=change_me_authen_jwt_secret

# 说明: AI_LAB_HOME / AI_LAB_WIKI / AI_LAB_VAULT 由 docker-compose.yml 固定为
# /app/data/vault（宿主机 ./data/vault 由本地 Obsidian 库同步而来），无需在此配置。
