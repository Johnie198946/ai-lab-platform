# AI Lab Platform 部署环境变量（复制为 .env 使用）
# docker compose 会自动读取同目录 .env

# PostgreSQL
POSTGRES_DB=ai_lab
POSTGRES_USER=ailab
POSTGRES_PASSWORD=change_me_strong_password

# 问答 API（/api/chat）需要
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Authen 统一认证（与认证服务共享的 HS256 密钥；配置后 API 强制 Bearer JWT）
AUTHEN_JWT_SECRET=change_me_authen_jwt_secret

# 外部登录 OAuth（必须使用 HTTPS 公网地址；供应商密钥由 Authen 服务保存）
AUTH_PUBLIC_BASE_URL=https://your-api.example.com
AUTH_WEB_RETURN_URL=https://your-web.example.com/login
AUTH_IOS_RETURN_URL=quantum://oauth/callback

# 租户知识策略 V2 / Authen 权益投影（生产必须替换为独立随机值）
TENANT_KNOWLEDGE_POLICY_V2=true
KNOWLEDGE_PACK_SUBSCRIPTION_V1=true
KNOWLEDGE_CAPABILITY_SECRET=change_me_capability_hmac_secret
AUTHEN_ENTITLEMENT_WEBHOOK_SECRET=change_me_entitlement_webhook_secret
AUTHEN_AI_PLATFORM_SERVICE_TOKEN=change_me_service_identity_token
AUTHEN_SUBSCRIPTION_URL=http://host.docker.internal:8006

# 点对点数据直传配置 (完全解耦 GitHub)
SERVER_USER=root
SERVER_HOST=
SERVER_PATH=/opt/ai-lab-platform/data
LOCAL_VAULT_PATH=/Users/dengzhaoyu/Desktop/AI Lab/AI Lab

# 说明: AI_LAB_HOME / AI_LAB_WIKI / AI_LAB_VAULT 由 docker-compose.yml 固定为
# /app/data/vault（宿主机 ./data/vault 由本地 Obsidian 库同步而来），无需在此配置。
